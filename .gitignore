# macOS metadata
.DS_Store
**/.DS_Store
__pycache__/
*.py[cod]

# Confidential working corpus. These folders contain client material, credentials,
# internal financials, source archives, recordings, and files above GitHub's limit.
/ADIB/
/C Presentations/
/Code/
/P & L/
/Resume/
/SAD/
/US/
/Aditya_Singh_Resume_Accenture_Enterprise_AI_Value_Strategy_v25.docx

# Publish only the sanitized PDF evidence library from the presentation workspace.
/P Presentations/*
!/P Presentations/decksPdf/
!/P Presentations/decksPdf/*.pdf

# Local inspection data emitted while validating public presentation samples.
samples/presentations/**/*.layout.json
samples/presentations/**/*.pptx.inspect.ndjson

# The complete 2,256-slide PowerPoint archive is preserved as versioned assets
# in GitHub Release `slide-archive-2026-08-30`. Keep the lightweight manifest
# in this folder, but do not copy the 602 MiB binary archive back into Pages.
/samples/presentations/full-library/*.pptx

# Generated local-only presentation corpus and QA workspace. The source material
# contains customer-confidential slides and must not be published through Pages.
/.tmp-master-split.*/
/.tmp-ai-projects.*/
/.tmp-technical-projects-public/
/.tmp-technical-projects-previous/
/internal/
